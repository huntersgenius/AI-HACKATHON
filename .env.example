# Copy to .env and fill in. Never commit .env.

# Anthropic API key for analyzers/llm_analyzer.py.
# If empty, set FEATURE_LLM_ANALYZER=0 — the rule analyzer keeps the demo working.
ANTHROPIC_API_KEY=

# Flask
FLASK_DEBUG=1
SECRET_KEY=dev-secret-change-me
HOST=0.0.0.0
PORT=5000

# SQLite file (relative paths are resolved from the project root)
DB_PATH=hamroh.db

# LLM
LLM_MODEL=claude-opus-5
LLM_TIMEOUT_SECONDS=10
TRIAGE_PROMPT=triage_v1.txt
TRIAGE_CASE_PROMPT=triage_v1_case.txt

# Feature flags (1/0) — defaults live in config.py FEATURES
FEATURE_LLM_ANALYZER=1
FEATURE_DOCTOR_REPLY=1
FEATURE_TREND_CHART=0
FEATURE_SMS_NOTIFIER=0
FEATURE_MULTI_QUESTION=0
