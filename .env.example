# Copy to .env and fill in. Never commit .env.

# Anthropic API key for analyzers/llm_analyzer.py.
# If empty, set FEATURE_LLM_ANALYZER=0 — the rule analyzer keeps the demo working.
ANTHROPIC_API_KEY=

# Flask
FLASK_DEBUG=1
SECRET_KEY=dev-secret-change-me
HOST=0.0.0.0
PORT=5000

# SQLite file (relative paths are resolved from the project root)
DB_PATH=hamroh.db

# LLM
LLM_MODEL=claude-opus-5
LLM_TIMEOUT_SECONDS=10
TRIAGE_PROMPT=triage_v1.txt
TRIAGE_CASE_PROMPT=triage_v1_case.txt

# Feature flags (1/0) — defaults live in config.py FEATURES
FEATURE_LLM_ANALYZER=1
FEATURE_DOCTOR_REPLY=1
FEATURE_TREND_CHART=0
FEATURE_SMS_NOTIFIER=0
FEATURE_MULTI_QUESTION=0
# Keep this at 0 until SMARTCALL_API_KEY/SMARTCALL_GROUP_ID below point at a
# real account you control — the seeded demo patients have made-up phone
# numbers, and every red-alert answer in the smoke tests would try to call
# them for real.
FEATURE_CALL_NOTIFIER=0
FEATURE_PUSH_NOTIFICATIONS=1

# SmartCall (callmaster.uz) — automated voice-reminder calls.
# Docs: https://smartcall.uz/web/api/v1 ; groupID comes from the Statistika page.
SMARTCALL_API_KEY=
SMARTCALL_GROUP_ID=
SMARTCALL_API_URL=https://smartcall.uz/web/api/v1
SMARTCALL_TIMEOUT_SECONDS=10

# Web Push (VAPID) — generate with: python scripts/generate_vapid_keys.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=hamroh@example.uz
